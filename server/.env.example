NODE_ENV=
MONGODB_URI=
PORT=
FRONTEND_URL=
ALLOWED_ORIGINS= # Comma-separated list of allowed origins for CORS (e.g., http://localhost:3000,http://another.com)
API_URL=
LOG_LEVEL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
UPLOADS_DIR= # Relative path for dataset uploads (e.g., src/uploads/datasets)
MAX_UPLOAD_MB= # Maximum accepted EEG file size in megabytes (e.g., 50)
MODEL_DIR= # Directory holding the exported .onnx models (e.g., ./models)
DEFAULT_MODEL_ID= # Model loaded on boot when no subject is supplied (e.g., global)
ML_SERVICE_URL= # Base URL of the Python FastAPI microservice (e.g., http://localhost:8000)
USE_ML_SERVICE= # true -> forward features to Python; false -> local ONNX inference
REFERENCE_DATASET_PATH= # Path to the dataset replayed in simulation mode (e.g., ./models/A01T.gdf)
SAMPLE_RATE= # Acquisition rate in Hz (e.g., 250)
BANDPASS_LOW= # Bandpass lower cutoff in Hz (e.g., 8)
BANDPASS_HIGH= # Bandpass upper cutoff in Hz (e.g., 30)
NOTCH_FREQ= # Mains notch frequency in Hz (e.g., 50)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
