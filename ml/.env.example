# Where csp_lda_{id}.onnx and csp_{id}.json live. Must be the same directory
# the Node server reads as MODEL_DIR, or the two will serve different models.
MODEL_DIR=../server/models

# Model loaded when a request names no subject.
DEFAULT_MODEL_ID=global

# Must match SAMPLE_RATE in server/.env — the filter coefficients are keyed by it.
SAMPLE_RATE=250

# Must resolve to a band the server also has coefficients for.
BANDPASS_LOW=8
BANDPASS_HIGH=30
NOTCH_FREQ=50

# Port the microservice binds. Matches ML_SERVICE_URL in server/.env.
PORT=8000
